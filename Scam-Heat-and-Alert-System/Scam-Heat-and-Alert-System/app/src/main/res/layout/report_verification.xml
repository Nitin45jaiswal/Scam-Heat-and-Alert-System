<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/verificationRootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080D1A"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="vertical"
    android:fadeScrollbars="true">

    <LinearLayout
        android:id="@+id/verificationRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="24dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">

        <!-- TOP BRAND -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="35dp"
                android:background="#FF3155" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCAMHEAT"
                    android:textColor="#F5F7FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />

                <TextView
                    android:id="@+id/tvVerificationEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="ADMIN CONTROL CENTER"
                    android:textColor="#FF718B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● LIVE"
                android:textColor="#36E0A1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:background="@drawable/bg_verification_live_badge" />

        </LinearLayout>

        <!-- PAGE TITLE -->
        <TextView
            android:id="@+id/tvVerificationHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Report Verification"
            android:textColor="#F5F7FF"
            android:textSize="28sp"
            android:fontFamily="sans"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <TextView
            android:id="@+id/tvVerificationSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="22dp"
            android:text="Investigate suspicious activity, review evidence, and verify community reports."
            android:textColor="#9BA9C3"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <!-- SEARCH PANEL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_verification_input"
            android:elevation="2dp">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="#65738C"
                android:contentDescription="Search reports" />

            <EditText
                android:id="@+id/etVerificationSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@android:color/transparent"
                android:hint="Search reports, details or status"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:textColor="#F5F7FF"
                android:textColorHint="#65738C"
                android:textSize="14sp"
                android:padding="0dp"
                android:importantForAutofill="no" />

        </LinearLayout>

        <!-- FILTER LABEL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FILTER REPORTS"
                android:textColor="#9BA9C3"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CATEGORY"
                android:textColor="#65738C"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

        </LinearLayout>

        <!-- CATEGORY FILTER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingEnd="8dp"
            android:background="@drawable/bg_verification_input">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_verification_filter_dot" />

            <Spinner
                android:id="@+id/spVerificationCategory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:paddingStart="2dp"
                android:paddingEnd="6dp"
                android:spinnerMode="dropdown" />

        </LinearLayout>

        <!-- REFRESH BUTTON -->
        <Button
            android:id="@+id/btnRefreshVerification"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="13dp"
            android:background="@drawable/bg_verification_refresh"
            android:stateListAnimator="@null"
            android:text="↻    Refresh Reports"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:drawablePadding="8dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- SECTION DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:background="#202B40" />

        <!-- REPORT LIST HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:layout_marginBottom="15dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Submitted Reports"
                    android:textColor="#F5F7FF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Review submissions and evidence"
                    android:textColor="#65738C"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADMIN REVIEW"
                android:textColor="#FF718B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/bg_verification_badge" />

        </LinearLayout>

        <!-- REPORT CARDS ARE ADDED BY JAVA -->
        <LinearLayout
            android:id="@+id/llVerificationReports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="12dp" />

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="SCAMHEAT  •  TRUST &amp; SAFETY"
            android:textColor="#4D5B73"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:paddingTop="14dp"
            android:paddingBottom="8dp" />

    </LinearLayout>

</ScrollView>
